# --- Research projects (project/NN_<name>/) --------------------------------
# The 0* rule above also matches project/01_* etc.: re-include the project
# folders. Notes, scripts, case set-ups and measured data are tracked; run
# output, logs, generated images, local Python envs and publisher PDFs/movies
# (copyright) are not.
!project/[0-9][0-9]_*/
project/**/processor*/
project/**/postProcessing/
project/**/VTKs/
project/**/polyMesh/
project/**/log.*
!project/**/log.md
project/**/baseline_log*
project/**/open.foam
project/**/*.pdf
project/**/video/
project/**/*.mp4
project/**/*.gif
project/**/__pycache__/
project/**/.venv/
project/**/keyhole_depth.csv
project/**/crosssection*.png
project/03_*/runs*/
project/03_*/state*.json
project/03_*/driver.log
project/03_*/dashboard.html*
project/03_*/backup/
project/03_*/surrogate_history/
project/03_*/results.md
