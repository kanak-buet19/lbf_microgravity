FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
);

regions
(
    // plate: y >= 120 um (argon layer above)
    boxToCell
    {
        box (-1 120e-6 -1) (1 1 1);
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
        );
    }
);

