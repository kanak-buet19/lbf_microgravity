FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     laserbeamFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1.5e-3;         // = end of constant/timeVsLaserPosition

deltaT          1e-9;
writeControl    adjustableRunTime;
writeInterval   2e-5;           // one Huang X-ray frame
purgeWrite      0;
writeFormat     binary;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.25;           // as cunninghamValidation tutorial
maxAlphaCo      0.25;
maxDeltaT       1e-6;

functions
{
    // min/max and their cell positions every step (log + postProcessing/)
    minMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U T p_rgh alpha.metal);
        mode            magnitude;
        location        yes;
        writeToFile     yes;
        log             yes;
        executeControl  timeStep;
        writeControl    timeStep;
    }
}

