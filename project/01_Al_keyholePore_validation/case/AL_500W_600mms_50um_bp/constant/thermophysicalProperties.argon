FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.argon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Argon shielding gas (Huang et al.: chamber filled with argon at +10 kPa).

phaseState      gaseous;

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}

// Not used for a gas, but read by the solver.
TSolidus        5.0;
TLiquidus       10.0;
LatentHeat      1.0;
elec_conductivity       1.0;
magnetic_permeability   1.256e-6;

mixture
{
    specie
    {
        molWeight   39.95;
    }
    thermodynamics
    {
        Cp          520;
        Hf          0;
    }
    transport
    {
        mu          2.27e-5;
        Pr          0.67;
    }
}

// ************************************************************************* //
