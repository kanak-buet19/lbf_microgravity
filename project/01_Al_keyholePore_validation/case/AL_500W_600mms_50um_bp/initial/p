FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1.11325e5;

boundaryField
{
    top
    {
        type            calculated;
        value           $internalField;
    }
    bottom
    {
        type            calculated;
        value           $internalField;
    }
    xMin
    {
        type            calculated;
        value           $internalField;
    }
    xMax
    {
        type            calculated;
        value           $internalField;
    }
    zMin
    {
        type            calculated;
        value           $internalField;
    }
    zMax
    {
        type            calculated;
        value           $internalField;
    }
}

